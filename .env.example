# WebReceipt runs fully in deterministic simulator mode without credentials.
PORT=3000
# Local/self-hosted engine persistence path. On Vercel, the internal engine uses
# the writable temporary directory; anonymous user-visible receipt history is
# isolated per browser and is not read from this shared server file.
WEBRECEIPT_STATE_FILE=data/state.json

# Public URL collection. Direct public HTML works without credentials.
# Response size/time, request-rate and concurrency caps keep anonymous requests
# bounded. Override these only after measuring production traffic.
PUBLIC_WEB_MAX_BYTES=2000000
PUBLIC_WEB_TIMEOUT_MS=20000
WEBRECEIPT_PUBLIC_RATE_LIMIT_PER_MINUTE=12
WEBRECEIPT_PUBLIC_MAX_CONCURRENT=4

# Bright Data live mode.
# Keep the API token secret. The verified collector ID is public metadata and is
# already the server default; set this only when deliberately rotating collectors.
BRIGHT_DATA_API_TOKEN=
BRIGHT_DATA_COLLECTOR_ID=c_mt3ha1iv1jgm8eg813
# Optional Web Unlocker zone for arbitrary public pages that block direct fetches.
# When both this and WEBRECEIPT_ALLOW_PUBLIC_LIVE_OBSERVE=true are set, the normal
# console may use Bright Data Web Unlocker before compiling the same Deal Contract.
BRIGHT_DATA_UNLOCKER_ZONE=
# Optional default/allowlisted public URL for the protected Scraper Studio route.
BRIGHT_DATA_TARGET_URL=https://web-receipt-tawny.vercel.app/fixture/hotel
BRIGHT_DATA_POLL_MS=5000
BRIGHT_DATA_COLLECTION_TIMEOUT_MS=240000
BRIGHT_DATA_HEAL_TIMEOUT_MS=900000
BRIGHT_DATA_REQUEST_TIMEOUT_MS=30000

# Strongly recommended for protected live observe/heal operations.
# Send this value only as X-WebReceipt-Operator from a trusted terminal/agent.
WEBRECEIPT_OPERATOR_TOKEN=

# Leave false. Set true only if you explicitly want anonymous callers to invoke
# protected paid Bright Data operations, including Scraper Studio self-healing.
WEBRECEIPT_ALLOW_UNPROTECTED_LIVE=false

# Direct public scraping works regardless of this setting. Set true only when
# BRIGHT_DATA_UNLOCKER_ZONE is configured and you deliberately want anonymous
# console requests to consume Bright Data Web Unlocker credits as a fallback.
WEBRECEIPT_ALLOW_PUBLIC_LIVE_OBSERVE=false
