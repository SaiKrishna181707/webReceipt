# WebReceipt runs fully in deterministic simulator mode without credentials.
PORT=3000
WEBRECEIPT_STATE_FILE=data/state.json

# Bright Data live mode.
BRIGHT_DATA_API_TOKEN=
BRIGHT_DATA_COLLECTOR_ID=c_xxxxxxxxxxxxxxxx
BRIGHT_DATA_POLL_MS=5000
BRIGHT_DATA_COLLECTION_TIMEOUT_MS=240000
BRIGHT_DATA_HEAL_TIMEOUT_MS=900000
BRIGHT_DATA_REQUEST_TIMEOUT_MS=30000

# Strongly recommended for any public deployment that has Bright Data credentials.
# The browser sends this only in X-WebReceipt-Operator for live/mutating actions.
WEBRECEIPT_OPERATOR_TOKEN=

# Leave false. Set true only if you explicitly want anonymous visitors to be able
# to trigger paid Bright Data live operations and self-healing mutations.
WEBRECEIPT_ALLOW_UNPROTECTED_LIVE=false
